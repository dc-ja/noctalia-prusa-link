{
  "id": "prusa-link",
  "name": "PrusaLink",
  "version": "0.5.0",
  "minNoctaliaVersion": "4.7.7",
  "author": "dc-ja",
  "license": "MIT",
  "description": "Shows Prusa printer state and print progress in the bar. Click to open the PrusaLink web interface.",
  "tags": [
    "Bar",
    "3D Printing",
    "IoT"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "protocol": "https",
      "host": "127.0.0.1",
      "port": 8080,
      "username": "maker",
      "password": "",
      "offlineRefreshIntervalSec": 10,
      "idleRefreshIntervalSec": 2,
      "printingRefreshIntervalSec": 1
    }
  }
}
